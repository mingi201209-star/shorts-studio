    },
    {
      "id": 3,
      "text": "As a tire rolls across each groove, its contact with the road keeps changing.",
      "audio": "voice_03.wav",
      "raw_audio": "raw_voice_03.mp3",
      "timing": "voice_03.timing.json",
      "duration": 4.661917,
      "audio_sha256": "285c171a8bbd2602fbc2cda732d4dc94741381c10c580b9bf5e846436657e3d2",
      "raw_audio_sha256": "08741df2215138a2007d6879e64ae30b948f3a396d8ce433977f6671ea1b239c",
      "timing_sha256": "43901a0ede9f2f95605eec967f9ded3f19a6858dbb1d71098c8262b5f2e924fe"
    },
    {
      "id": 4,
      "text": "That repeated contact creates a rumbling sound and sends vibration through the car.",
      "audio": "voice_04.wav",
      "raw_audio": "raw_voice_04.mp3",
      "timing": "voice_04.timing.json",
      "duration": 4.661917,
      "audio_sha256": "0f3f06cbb6c837d55c4201d06e8cdc6e95ea16bb842a71b499967830bfeb287d",
      "raw_audio_sha256": "e57393874ec428f0e308f2af6b8d2103d8bbe602b7795eb9c581a1839bbae3d4",
