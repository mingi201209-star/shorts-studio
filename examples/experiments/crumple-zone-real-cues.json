{
  "source": "EP04 audio cues run 44078568443 (Edge TTS with measured word boundaries)",
  "target_seconds": 26.0,
  "narration_sha256": "64fd740c9c2ae8b8d2b15148eb491adcc6f4b34db8bcdce0ddb262827fad4553",
  "cues": [
    {
      "start": 0.09525,
      "end": 0.785708,
      "text": "Cars are designed"
    },
    {
      "start": 0.797625,
      "end": 1.357124,
      "text": "to crush."
    },
    {
      "start": 2.052583333333333,
      "end": 3.0763743333333333,
      "text": "Inside, hidden"
    },
    {
      "start": 3.0882913333333333,
      "end": 4.266832333333333,
      "text": "structures fold and"
    },
    {
      "start": 4.278749333333334,
      "end": 5.314457333333333,
      "text": "slow the car down"
    },
    {
      "start": 5.326374333333334,
      "end": 6.493041333333333,
      "text": "over a longer distance"
    },
    {
      "start": 6.504958333333334,
      "end": 6.909707333333333,
      "text": "and time."
    },
    {
      "start": 7.441916666666668,
      "end": 8.394290666666668,
      "text": "Watch the front rails"
    },
    {
      "start": 8.406207666666667,
      "end": 9.394290666666667,
      "text": "buckle and fold"
    },
    {
      "start": 9.406207666666667,
      "end": 10.406207666666667,
      "text": "as the car slows"
    },
    {
      "start": 10.537124666666667,
      "end": 11.608582666666667,
      "text": "all the way to a stop."
    },
    {
      "start": 12.147125,
      "end": 13.147124000000002,
      "text": "The rigid front stops"
    },
    {
      "start": 13.159041,
      "end": 14.182875000000001,
      "text": "in a tiny distance."
    },
    {
      "start": 14.587625000000001,
      "end": 15.659041000000002,
      "text": "The car bounces back"
    },
    {
      "start": 15.754291,
      "end": 16.670958,
      "text": "almost immediately."
    },
    {
      "start": 17.224458333333335,
      "end": 17.736374333333334,
      "text": "The passenger"
    },
    {
      "start": 17.748291333333334,
      "end": 18.641124333333334,
      "text": "compartment keeps"
    },
    {
      "start": 18.653041333333334,
      "end": 19.141124333333334,
      "text": "its shape."
    },
    {
      "start": 19.533999333333334,
      "end": 20.010207333333334,
      "text": "While the front"
    },
    {
      "start": 20.022083333333335,
      "end": 20.855416333333334,
      "text": "folds inward,"
    },
    {
      "start": 21.105416333333334,
      "end": 22.486415333333333,
      "text": "the cabin stays intact."
    },
    {
      "start": 23.04579166666667,
      "end": 23.90295766666667,
      "text": "The front is meant"
    },
    {
      "start": 23.91487466666667,
      "end": 24.45054066666667,
      "text": "to deform."
    },
    {
      "start": 24.85533266666667,
      "end": 25.56962366666667,
      "text": "The cabin isn't."
    }
  ]
}
