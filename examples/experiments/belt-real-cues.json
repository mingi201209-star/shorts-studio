 "beats": [
  {
   "start": 0,
   "end": 2.8237911250000005,
   "text": "Your seatbelt is built to give way on purpose."
  },
  {
   "start": 2.8237911250000005,
   "end": 4.992791250000001,
   "text": "In a crash it first snaps tight,"
  },
  {
   "start": 4.992791250000001,
   "end": 6.757041375000001,
   "text": "pulling you back into the seat."
  },
  {
   "start": 6.757041375000001,
   "end": 9.961749500000002,
   "text": "Then a twisting metal bar in the reel starts to give,"
  },
  {
   "start": 9.961749500000002,
   "end": 11.428374625000002,
   "text": "letting out a little belt."
  },
  {
   "start": 11.428374625000002,
   "end": 14.049749750000002,
   "text": "Your chest gets a longer, gentler stop."
  },
  {
   "start": 14.049749750000002,
   "end": 18.278249875,
   "text": "A belt with no give stops it almost at once, with a harder push."
  },
  {
   "start": 18.278249875,
   "end": 22.983,
   "text": "Same idea as a crumple zone: a longer stop means a smaller peak force."
  }
