{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 31.715,
  "cues": [
    {
      "start": 0.06,
      "end": 0.31,
      "text": "Why did a"
    },
    {
      "start": 0.3225,
      "end": 1.16,
      "text": "steel wall just"
    },
    {
      "start": 1.1725,
      "end": 1.5475,
      "text": "jump out of"
    },
    {
      "start": 1.56,
      "end": 1.9725,
      "text": "the road?"
    },
    {
      "start": 2.2325,
      "end": 2.395,
      "text": "It's a"
    },
    {
      "start": 2.4074999999999998,
      "end": 3.3575,
      "text": "security barrier."
    },
    {
      "start": 3.7699999999999996,
      "end": 4.6075,
      "text": "In an emergency"
    },
    {
      "start": 4.72,
      "end": 5.5200000000000005,
      "text": "it rises in"
    },
    {
      "start": 5.5325,
      "end": 6.232499999999999,
      "text": "about a second."
    },
    {
      "start": 6.492499999999999,
      "end": 7.129999999999999,
      "text": "Under the road,"
    },
    {
      "start": 7.517499999999999,
      "end": 8.2675,
      "text": "a hinged steel"
    },
    {
      "start": 8.28,
      "end": 9.68,
      "text": "plate waits inside"
    },
    {
      "start": 9.692499999999999,
      "end": 10.592500000000001,
      "text": "a concrete pit."
    },
    {
      "start": 10.8525,
      "end": 12.1775,
      "text": "Hydraulic pistons swing"
    },
    {
      "start": 12.19,
      "end": 12.815,
      "text": "its front edge"
    },
    {
      "start": 12.8275,
      "end": 14.0775,
      "text": "up, nearly three"
    },
    {
      "start": 14.09,
      "end": 14.8275,
      "text": "feet high."
    },
    {
      "start": 15.087499999999999,
      "end": 15.5375,
      "text": "A car that"
    },
    {
      "start": 15.549999999999999,
      "end": 16.2,
      "text": "hits it doesn't"
    },
    {
      "start": 16.2125,
      "end": 16.974999999999998,
      "text": "just bounce off"
    },
    {
      "start": 16.987499999999997,
      "end": 17.5,
      "text": "the steel."
    },
    {
      "start": 17.759999999999998,
      "end": 18.66,
      "text": "Thick struts push"
    },
    {
      "start": 18.6725,
      "end": 19.5975,
      "text": "the crash down"
    },
    {
      "start": 19.61,
      "end": 20.3725,
      "text": "into tons of"
    },
    {
      "start": 20.384999999999998,
      "end": 21.31,
      "text": "buried concrete."
    },
    {
      "start": 21.57,
      "end": 22.0075,
      "text": "So the car"
    },
    {
      "start": 22.02,
      "end": 23.1325,
      "text": "stops dead, and"
    },
    {
      "start": 23.145,
      "end": 23.745,
      "text": "its back end"
    },
    {
      "start": 23.7575,
      "end": 24.32,
      "text": "flips into"
    },
    {
      "start": 24.3325,
      "end": 24.8075,
      "text": "the air."
    },
    {
      "start": 25.0675,
      "end": 25.842499999999998,
      "text": "Tested ones can"
    },
    {
      "start": 25.854999999999997,
      "end": 26.779999999999998,
      "text": "stop a fifteen"
    },
    {
      "start": 26.792499999999997,
      "end": 27.755,
      "text": "thousand pound truck"
    },
    {
      "start": 27.7675,
      "end": 28.429999999999996,
      "text": "going fifty."
    },
    {
      "start": 28.689999999999998,
      "end": 29.214999999999996,
      "text": "That's what those"
    },
    {
      "start": 29.227499999999996,
      "end": 30.277499999999996,
      "text": "striped steel plates"
    },
    {
      "start": 30.289999999999996,
      "end": 31.002499999999998,
      "text": "at secure gates"
    },
    {
      "start": 31.014999999999997,
      "end": 31.514999999999997,
      "text": "are for."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 2.1725,
      "narration_en": "Why did a steel wall just jump out of the road?",
      "source_audio_sha256": "b375675beb627a46d1ad23cebfd65e54a1f9530e6bd446f5e0e960517e0fa683"
    },
    {
      "start": 2.1725,
      "end": 6.432499999999999,
      "narration_en": "It's a security barrier. In an emergency it rises in about a second.",
      "source_audio_sha256": "2995e185caca292da67e74c5d1e160a24b372539af7d0c4bfee073da4e152ebd"
    },
    {
      "start": 6.432499999999999,
      "end": 10.792499999999999,
      "narration_en": "Under the road, a hinged steel plate waits inside a concrete pit.",
      "source_audio_sha256": "627be07edae073de6a3ad322fca941713644ded4aef04f5d4a1e7e74dc2e709f"
    },
    {
      "start": 10.792499999999999,
      "end": 15.027499999999998,
      "narration_en": "Hydraulic pistons swing its front edge up, nearly three feet high.",
      "source_audio_sha256": "72066acb19388e031bf7e541e721f10f2c4d39597545c170a49efd56bf200449"
    },
    {
      "start": 15.027499999999998,
      "end": 17.7,
      "narration_en": "A car that hits it doesn't just bounce off the steel.",
      "source_audio_sha256": "68e637ec5449dbeac68979ee1867196d48b75831423102782dbd08a971313359"
    },
    {
      "start": 17.7,
      "end": 21.509999999999998,
      "narration_en": "Thick struts push the crash down into tons of buried concrete.",
      "source_audio_sha256": "efb451309e30d5c418f5b5a8b293528479a3ca8559023fb9076429dc89c133ec"
    },
    {
      "start": 21.509999999999998,
      "end": 25.007499999999997,
      "narration_en": "So the car stops dead, and its back end flips into the air.",
      "source_audio_sha256": "fb69e8ef3a1208eac49b658f0e8d886d66c7927a4676a6835ef6191f2b8aabc7"
    },
    {
      "start": 25.007499999999997,
      "end": 28.629999999999995,
      "narration_en": "Tested ones can stop a fifteen thousand pound truck going fifty.",
      "source_audio_sha256": "77917a85098eef3c95c71d1ab308a686bc483ea400ee52d86100a82116b70dcb"
    },
    {
      "start": 28.629999999999995,
      "end": 31.715,
      "narration_en": "That's what those striped steel plates at secure gates are for.",
      "source_audio_sha256": "cd570bbf663ed86762dafbd300c51cfff6ed204e74f1ed3b9c91b18680b876c3"
    }
  ],
