{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 34.614,
  "cues": [
    {
      "start": 0.06000000000000005,
      "end": 0.4110830000000001,
      "text": "How do you"
    },
    {
      "start": 0.4690829999999999,
      "end": 1.2350830000000002,
      "text": "stop a runaway"
    },
    {
      "start": 1.293083,
      "end": 1.757083,
      "text": "train at the"
    },
    {
      "start": 1.8150830000000002,
      "end": 2.013083,
      "text": "end of"
    },
    {
      "start": 2.048083,
      "end": 2.559083,
      "text": "the line?"
    },
    {
      "start": 2.8566956666666656,
      "end": 3.5970916666666657,
      "text": "Hitting a solid"
    },
    {
      "start": 3.6430916666666655,
      "end": 4.328091666666666,
      "text": "wall would wreck"
    },
    {
      "start": 4.386091666666665,
      "end": 5.478091666666666,
      "text": "it, so this"
    },
    {
      "start": 5.559091666666665,
      "end": 6.314091666666666,
      "text": "buffer stop is"
    },
    {
      "start": 6.383091666666665,
      "end": 7.219091666666666,
      "text": "built to slide."
    },
    {
      "start": 7.507288333333332,
      "end": 8.094100333333332,
      "text": "It's clamped to"
    },
    {
      "start": 8.152100333333332,
      "end": 8.768100333333331,
      "text": "the rails by"
    },
    {
      "start": 8.837100333333332,
      "end": 10.277100333333332,
      "text": "steel shoes, bolted"
    },
    {
      "start": 10.335100333333331,
      "end": 10.846100333333332,
      "text": "on tight."
    },
    {
      "start": 11.166108999999995,
      "end": 11.731858999999996,
      "text": "When a train"
    },
    {
      "start": 11.789858999999996,
      "end": 12.752858999999996,
      "text": "hits, the stop's"
    },
    {
      "start": 12.787858999999996,
      "end": 13.646858999999996,
      "text": "hydraulic buffers"
    },
    {
      "start": 13.670858999999995,
      "end": 14.424858999999996,
      "text": "squash first."
    },
    {
      "start": 14.744867666666662,
      "end": 15.884825666666663,
      "text": "Then the whole"
    },
    {
      "start": 15.919825666666663,
      "end": 16.78982566666666,
      "text": "stop gets shoved"
    },
    {
      "start": 16.824825666666662,
      "end": 17.637825666666664,
      "text": "along the rails,"
    },
    {
      "start": 17.77682566666666,
      "end": 18.461825666666662,
      "text": "and the friction"
    },
    {
      "start": 18.519825666666662,
      "end": 19.274825666666665,
      "text": "turns the train's"
    },
    {
      "start": 19.29782566666666,
      "end": 20.26182566666666,
      "text": "speed into heat."
    },
    {
      "start": 20.58183433333333,
      "end": 21.57148033333333,
      "text": "A six-car train"
    },
    {
      "start": 21.62948033333333,
      "end": 22.44248033333333,
      "text": "at fifteen miles"
    },
    {
      "start": 22.476480333333328,
      "end": 23.208480333333327,
      "text": "an hour stops"
    },
    {
      "start": 23.25448033333333,
      "end": 23.62648033333333,
      "text": "in about"
    },
    {
      "start": 23.67248033333333,
      "end": 24.299480333333328,
      "text": "sixty feet."
    },
    {
      "start": 24.603994999999994,
      "end": 25.53720299999999,
      "text": "That's gentler than"
    },
    {
      "start": 25.60720299999999,
      "end": 26.245202999999993,
      "text": "slamming on the"
    },
    {
      "start": 26.291202999999992,
      "end": 26.675202999999993,
      "text": "brakes in"
    },
    {
      "start": 26.721202999999992,
      "end": 27.20920299999999,
      "text": "your car."
    },
    {
      "start": 27.46921166666666,
      "end": 28.398211666666658,
      "text": "Yes, that's"
    },
    {
      "start": 28.44421166666666,
      "end": 28.97821166666666,
      "text": "me driving."
    },
    {
      "start": 29.06021166666666,
      "end": 29.57021166666666,
      "text": "Again."
    },
    {
      "start": 29.890220333333325,
      "end": 31.695991333333325,
      "text": "Afterwards, crews loosen"
    },
    {
      "start": 31.753991333333325,
      "end": 32.82199133333333,
      "text": "the bolts, push"
    },
    {
      "start": 32.87999133333333,
      "end": 33.45999133333333,
      "text": "it back, and"
    },
    {
      "start": 33.52999133333333,
      "end": 34.353991333333326,
      "text": "tighten them again."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 2.8190916666666657,
      "narration_en": "How do you stop a runaway train at the end of the line?",
      "source_audio_sha256": "a8b16b2e1289cde81611025d82d63425f4967393d8ab946b25059f133c323c7e"
    },
    {
      "start": 2.8190916666666657,
      "end": 7.4791003333333315,
      "narration_en": "Hitting a solid wall would wreck it, so this buffer stop is built to slide.",
      "source_audio_sha256": "c56a8b27cc649d1dc7163d72def90ac4029262c720826bc25410cc29c1f83c07"
    },
    {
      "start": 7.4791003333333315,
      "end": 11.106108999999996,
      "narration_en": "It's clamped to the rails by steel shoes, bolted on tight.",
      "source_audio_sha256": "34a94c5524293e41921bcb1bfe5ef943a6bc19954a72381180d4a30e9abb11ff"
    },
    {
      "start": 11.106108999999996,
      "end": 14.684867666666662,
      "narration_en": "When a train hits, the stop's hydraulic buffers squash first.",
      "source_audio_sha256": "37715d09f0f11098999cf68a56c350084e16eb64833fcfa790b6ab2c68ee698d"
    },
    {
      "start": 14.684867666666662,
      "end": 20.521834333333327,
      "narration_en": "Then the whole stop gets shoved along the rails, and the friction turns the train's speed into heat.",
      "source_audio_sha256": "eec851fec45d05f06849e45a74276197212342444e4267de429278810519277d"
    },
    {
      "start": 20.521834333333327,
      "end": 24.550202999999993,
      "narration_en": "A six-car train at fifteen miles an hour stops in about sixty feet.",
      "source_audio_sha256": "e95321f61e079d5e1a3089f54a5af46a9672f5c5aad953457d557b4040d031e3"
    },
    {
      "start": 24.550202999999993,
      "end": 27.46921166666666,
      "narration_en": "That's gentler than slamming on the brakes in your car.",
      "source_audio_sha256": "29c2927d9855bc797d924118ff8fa19db0c9d5f2ee272f930f14b9dec7e5951c"
    },
    {
      "start": 27.46921166666666,
      "end": 29.830220333333326,
      "narration_en": "Yes, that's me driving. Again.",
      "source_audio_sha256": "56bea20b75916bbc569672494982fe99d89d5696f8606f8227cfb6d677f4b578"
    },
    {
      "start": 29.830220333333326,
      "end": 34.614,
      "narration_en": "Afterwards, crews loosen the bolts, push it back, and tighten them again.",
      "source_audio_sha256": "71cfca53118a1d99bb2fc8d46760d093f0ded6d9476a035dfcb408c036db5688"
    }
  ],
