{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 35.014,
  "cues": [
    {
      "start": 0.06000000000000005,
      "end": 0.4110830000000001,
      "text": "How do you"
    },
    {
      "start": 0.4690829999999999,
      "end": 1.2350830000000002,
      "text": "stop a runaway"
    },
    {
      "start": 1.293083,
      "end": 1.757083,
      "text": "train at the"
    },
    {
      "start": 1.8150830000000002,
      "end": 2.013083,
      "text": "end of"
    },
    {
      "start": 2.048083,
      "end": 2.559083,
      "text": "the line?"
    },
    {
      "start": 2.8567211111111117,
      "end": 3.5971171111111118,
      "text": "Hitting a solid"
    },
    {
      "start": 3.6431171111111116,
      "end": 4.328117111111112,
      "text": "wall would wreck"
    },
    {
      "start": 4.386117111111112,
      "end": 5.4781171111111115,
      "text": "it, so this"
    },
    {
      "start": 5.559117111111112,
      "end": 6.314117111111112,
      "text": "buffer stop is"
    },
    {
      "start": 6.383117111111112,
      "end": 7.219117111111112,
      "text": "built to slide."
    },
    {
      "start": 7.507339222222224,
      "end": 8.094151222222223,
      "text": "It's clamped to"
    },
    {
      "start": 8.152151222222223,
      "end": 8.768151222222224,
      "text": "the rails by"
    },
    {
      "start": 8.837151222222223,
      "end": 10.277151222222223,
      "text": "steel shoes, bolted"
    },
    {
      "start": 10.335151222222223,
      "end": 10.846151222222224,
      "text": "on tight."
    },
    {
      "start": 11.166185333333335,
      "end": 11.731935333333336,
      "text": "When a train"
    },
    {
      "start": 11.789935333333336,
      "end": 12.752935333333335,
      "text": "hits, the stop's"
    },
    {
      "start": 12.787935333333335,
      "end": 13.646935333333335,
      "text": "hydraulic buffers"
    },
    {
      "start": 13.670935333333334,
      "end": 14.424935333333336,
      "text": "squash first."
    },
    {
      "start": 14.744969444444449,
      "end": 15.884927444444449,
      "text": "Then the whole"
    },
    {
      "start": 15.919927444444449,
      "end": 16.789927444444444,
      "text": "stop gets shoved"
    },
    {
      "start": 16.824927444444448,
      "end": 17.63792744444445,
      "text": "along the rails,"
    },
    {
      "start": 17.776927444444446,
      "end": 18.46192744444445,
      "text": "and the friction"
    },
    {
      "start": 18.51992744444445,
      "end": 19.27492744444445,
      "text": "turns the train's"
    },
    {
      "start": 19.297927444444447,
      "end": 20.261927444444446,
      "text": "speed into heat."
    },
    {
      "start": 20.581961555555562,
      "end": 21.571607555555563,
      "text": "A six-car train"
    },
    {
      "start": 21.629607555555562,
      "end": 22.44260755555556,
      "text": "at fifteen miles"
    },
    {
      "start": 22.47660755555556,
      "end": 23.20860755555556,
      "text": "an hour stops"
    },
    {
      "start": 23.254607555555562,
      "end": 23.626607555555562,
      "text": "in about"
    },
    {
      "start": 23.67260755555556,
      "end": 24.29960755555556,
      "text": "sixty feet."
    },
    {
      "start": 24.61035566666667,
      "end": 25.891126666666672,
      "text": "Gentle enough that"
    },
    {
      "start": 25.926126666666672,
      "end": 26.51812666666667,
      "text": "the coffee in"
    },
    {
      "start": 26.56412666666667,
      "end": 26.93612666666667,
      "text": "the cab"
    },
    {
      "start": 27.005126666666673,
      "end": 27.609126666666672,
      "text": "doesn't spill."
    },
    {
      "start": 27.869160777777783,
      "end": 28.79816077777778,
      "text": "Yes, that's"
    },
    {
      "start": 28.844160777777784,
      "end": 29.378160777777783,
      "text": "me driving."
    },
    {
      "start": 29.460160777777784,
      "end": 29.97016077777778,
      "text": "Again."
    },
    {
      "start": 30.290194888888895,
      "end": 32.0959658888889,
      "text": "Afterwards, crews loosen"
    },
    {
      "start": 32.1539658888889,
      "end": 33.221965888888896,
      "text": "the bolts, push"
    },
    {
      "start": 33.279965888888896,
      "end": 33.8599658888889,
      "text": "it back, and"
    },
    {
      "start": 33.929965888888894,
      "end": 34.7539658888889,
      "text": "tighten them again."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 2.8191171111111117,
      "narration_en": "How do you stop a runaway train at the end of the line?",
      "source_audio_sha256": "59ab18545f7c382af6792a9547bbd05e454c65bb0cb4c3cfcb290eb2eecb4d95"
    },
    {
      "start": 2.8191171111111117,
      "end": 7.479151222222224,
      "narration_en": "Hitting a solid wall would wreck it, so this buffer stop is built to slide.",
      "source_audio_sha256": "19a8366398f6372c97cab4c58fac5308ec1aee6a9bcf98adc51c128fb0a9fa04"
    },
    {
      "start": 7.479151222222224,
      "end": 11.106185333333336,
      "narration_en": "It's clamped to the rails by steel shoes, bolted on tight.",
      "source_audio_sha256": "f34df6ccf6827b45daa986859855e7ec6be9b1bec7d9d60fcad4269cbc15bb23"
    },
    {
      "start": 11.106185333333336,
      "end": 14.684969444444448,
      "narration_en": "When a train hits, the stop's hydraulic buffers squash first.",
      "source_audio_sha256": "84c8b37803c1effa73bca2beee02e8e2487ed86e3031b91d8742a28ca211e9b4"
    },
    {
      "start": 14.684969444444448,
      "end": 20.52196155555556,
      "narration_en": "Then the whole stop gets shoved along the rails, and the friction turns the train's speed into heat.",
      "source_audio_sha256": "ba1035b9307fe3694ac74a9b3af9e11a51afad0ce6a8ee42d0e0de744da7cd23"
    },
    {
      "start": 20.52196155555556,
      "end": 24.550355666666672,
      "narration_en": "A six-car train at fifteen miles an hour stops in about sixty feet.",
      "source_audio_sha256": "121ac86d7f6023634f26f7deacbb88f8aeb925fb9600c70b45a1f5700e57dee7"
    },
    {
      "start": 24.550355666666672,
      "end": 27.869160777777783,
      "narration_en": "Gentle enough that the coffee in the cab doesn't spill.",
      "source_audio_sha256": "e6d33550527c3b45cef2d3fddf51d23a1a09a8009ecb4fdaa9dcc0a0944822b2"
    },
    {
      "start": 27.869160777777783,
      "end": 30.230194888888896,
      "narration_en": "Yes, that's me driving. Again.",
      "source_audio_sha256": "a14c74943435091ef57e948ce7fd8d2903b116931fd6f7042f8fcf749272f429"
    },
    {
      "start": 30.230194888888896,
      "end": 35.014,
      "narration_en": "Afterwards, crews loosen the bolts, push it back, and tighten them again.",
      "source_audio_sha256": "c291ca92dc0c0282c467b568cc901c489d482bdc3220eeece43bfc78fa840cbd"
    }
  ],
