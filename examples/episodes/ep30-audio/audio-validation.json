{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 39.096,
  "cues": [
    {
      "start": 0.06,
      "end": 0.613999,
      "text": "Why is this"
    },
    {
      "start": 0.628166,
      "end": 1.665124,
      "text": "giant bridge spinning"
    },
    {
      "start": 1.679333,
      "end": 2.631041,
      "text": "above a railway?"
    },
    {
      "start": 2.891056818181818,
      "end": 3.615472818181818,
      "text": "It's a road"
    },
    {
      "start": 3.629681818181818,
      "end": 4.439347818181818,
      "text": "bridge in China"
    },
    {
      "start": 4.453556818181818,
      "end": 5.064347818181818,
      "text": "that was built"
    },
    {
      "start": 5.078556818181818,
      "end": 6.2859728181818175,
      "text": "beside the tracks."
    },
    {
      "start": 6.545988636363636,
      "end": 7.653945636363637,
      "text": "Trains can't stop"
    },
    {
      "start": 7.668154636363636,
      "end": 8.449404636363637,
      "text": "for long so"
    },
    {
      "start": 8.463613636363636,
      "end": 9.429529636363638,
      "text": "it's built first"
    },
    {
      "start": 9.514738636363637,
      "end": 9.997696636363637,
      "text": "and turned"
    },
    {
      "start": 10.011904636363637,
      "end": 10.736320636363637,
      "text": "into place."
    },
    {
      "start": 10.996336454545455,
      "end": 11.848627454545456,
      "text": "The whole bridge"
    },
    {
      "start": 11.862794454545455,
      "end": 12.573044454545455,
      "text": "sits on one"
    },
    {
      "start": 12.587252454545455,
      "end": 13.638377454545456,
      "text": "giant ball joint"
    },
    {
      "start": 13.652586454545455,
      "end": 14.277585454545456,
      "text": "in its pier."
    },
    {
      "start": 14.537601272727272,
      "end": 15.602934272727273,
      "text": "It weighs forty-six"
    },
    {
      "start": 15.617142272727273,
      "end": 16.625684272727273,
      "text": "thousand tons and"
    },
    {
      "start": 16.639892272727273,
      "end": 17.49214227272727,
      "text": "is almost nine"
    },
    {
      "start": 17.506351272727272,
      "end": 18.58589227272727,
      "text": "hundred feet long."
    },
    {
      "start": 18.84590809090909,
      "end": 19.65557409090909,
      "text": "Then it slowly"
    },
    {
      "start": 19.66978309090909,
      "end": 20.32315709090909,
      "text": "turns on that"
    },
    {
      "start": 20.33736609090909,
      "end": 20.96236609090909,
      "text": "one joint."
    },
    {
      "start": 21.22238190909091,
      "end": 22.35875590909091,
      "text": "It swung fifty-two"
    },
    {
      "start": 22.372964909090907,
      "end": 23.012131909090908,
      "text": "degrees in"
    },
    {
      "start": 23.026339909090908,
      "end": 24.19113090909091,
      "text": "sixty-eight minutes."
    },
    {
      "start": 24.45114672727273,
      "end": 25.23239672727273,
      "text": "That's about eight"
    },
    {
      "start": 25.24660472727273,
      "end": 26.226687727272726,
      "text": "times slower than"
    },
    {
      "start": 26.240937727272726,
      "end": 26.752271727272728,
      "text": "a clock's"
    },
    {
      "start": 26.766479727272728,
      "end": 27.490937727272726,
      "text": "minute hand."
    },
    {
      "start": 27.750953545454546,
      "end": 28.802077545454544,
      "text": "The railway gave"
    },
    {
      "start": 28.816286545454545,
      "end": 29.455535545454545,
      "text": "the builders a"
    },
    {
      "start": 29.469703545454546,
      "end": 30.279369545454546,
      "text": "window of under"
    },
    {
      "start": 30.293578545454544,
      "end": 31.174244545454545,
      "text": "two hours."
    },
    {
      "start": 31.434260363636366,
      "end": 32.229718363636366,
      "text": "And trains were"
    },
    {
      "start": 32.24392636363636,
      "end": 33.465509363636365,
      "text": "rolling underneath again"
    },
    {
      "start": 33.479718363636366,
      "end": 34.260968363636366,
      "text": "soon after."
    },
    {
      "start": 34.520984181818186,
      "end": 35.14598318181818,
      "text": "That's why some"
    },
    {
      "start": 35.16019218181818,
      "end": 36.19710818181819,
      "text": "bridges in China"
    },
    {
      "start": 36.21131718181818,
      "end": 37.50390018181818,
      "text": "are built sideways"
    },
    {
      "start": 37.518150181818186,
      "end": 38.12894218181818,
      "text": "and then spun"
    },
    {
      "start": 38.143150181818186,
      "end": 38.895984181818186,
      "text": "into place."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 2.831056818181818,
      "narration_en": "Why is this giant bridge spinning above a railway?",
      "source_audio_sha256": "9a21cdfb885885a746fd185d15fca849956ec3edb3928f277f180d0ab30afa94"
    },
    {
      "start": 2.831056818181818,
      "end": 6.485988636363636,
      "narration_en": "It's a road bridge in China that was built beside the tracks.",
      "source_audio_sha256": "619cb0fe63509507f2684176ef62bee3efbe6c0af60ff3e2b69a987a21a483f3"
    },
    {
      "start": 6.485988636363636,
      "end": 10.936336454545454,
      "narration_en": "Trains can't stop for long so it's built first and turned into place.",
      "source_audio_sha256": "4704edab93acbae71bf935468adea6bf0fcfdcb58809f12d46375eb150058f00"
    },
    {
      "start": 10.936336454545454,
      "end": 14.477601272727272,
      "narration_en": "The whole bridge sits on one giant ball joint in its pier.",
      "source_audio_sha256": "416386095a46c40fea94e4590c21a51bc457979ffc3cb71a93c223f62ab40867"
    },
    {
      "start": 14.477601272727272,
      "end": 18.78590809090909,
      "narration_en": "It weighs forty-six thousand tons and is almost nine hundred feet long.",
      "source_audio_sha256": "2c1a6ff995faf412c938a155eb93a20a1a200cba7c1491e18c12a6a9e146a514"
    },
    {
      "start": 18.78590809090909,
      "end": 21.162381909090907,
      "narration_en": "Then it slowly turns on that one joint.",
      "source_audio_sha256": "686fddf196d15e2efc47b1cb40025e6b3e02ab6106ee62b9bcb3c35cea601ec6"
    },
    {
      "start": 21.162381909090907,
      "end": 24.391146727272726,
      "narration_en": "It swung fifty-two degrees in sixty-eight minutes.",
      "source_audio_sha256": "943eb46ea5be7d01b34e2cbaae4bb500e70e69014ecdcb6c765158b34ab0cb26"
    },
    {
      "start": 24.391146727272726,
      "end": 27.690953545454544,
      "narration_en": "That's about eight times slower than a clock's minute hand.",
      "source_audio_sha256": "96dcdb87781b84cfe0ab01eb630d5f92ff2ae67623f0935d712a2a186d789b25"
    },
    {
      "start": 27.690953545454544,
      "end": 31.374260363636363,
      "narration_en": "The railway gave the builders a window of under two hours.",
      "source_audio_sha256": "82c60e914b1005d266deb222f17f7f94e046808523e9eb15bb9efe36400e1543"
    },
    {
      "start": 31.374260363636363,
      "end": 34.46098418181818,
      "narration_en": "And trains were rolling underneath again soon after.",
      "source_audio_sha256": "8a68d63f1364029b63966783dc45118249788b7a708f01290f6b49b434bca968"
    },
    {
      "start": 34.46098418181818,
      "end": 39.096,
      "narration_en": "That's why some bridges in China are built sideways and then spun into place.",
      "source_audio_sha256": "309dd4f35422d92d7fc0922ff2b047f0f39e0ec11ef92ffd00e3abe8e8e353f6"
    }
  ],
