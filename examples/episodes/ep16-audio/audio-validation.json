{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 31.964,
  "cues": [
    {
      "start": 0.06,
      "end": 0.6425409999999999,
      "text": "Why do tires"
    },
    {
      "start": 0.654667,
      "end": 1.152249,
      "text": "explode on"
    },
    {
      "start": 1.1643750000000002,
      "end": 1.6862080000000002,
      "text": "the highway?"
    },
    {
      "start": 1.9462313333333332,
      "end": 2.953523333333333,
      "text": "Most blowouts start"
    },
    {
      "start": 2.965648333333333,
      "end": 3.9972313333333336,
      "text": "days earlier, with"
    },
    {
      "start": 4.009356333333333,
      "end": 4.604022333333333,
      "text": "a tire that's"
    },
    {
      "start": 4.616148333333333,
      "end": 4.870980233333333,
      "text": "just a"
    },
    {
      "start": 4.883148333333333,
      "end": 5.417106333333333,
      "text": "little low."
    },
    {
      "start": 5.677129666666666,
      "end": 6.223254666666667,
      "text": "Every time it"
    },
    {
      "start": 6.235379666666666,
      "end": 7.303337666666666,
      "text": "rolls, the soft"
    },
    {
      "start": 7.315462666666666,
      "end": 8.529087666666666,
      "text": "sidewall bends flat"
    },
    {
      "start": 8.541212666666665,
      "end": 9.050920666666665,
      "text": "at the bottom,"
    },
    {
      "start": 9.366462666666665,
      "end": 10.325212666666665,
      "text": "then springs back."
    },
    {
      "start": 10.585235999999998,
      "end": 11.410485,
      "text": "At sixty miles"
    },
    {
      "start": 11.422610999999998,
      "end": 12.199319,
      "text": "an hour, that"
    },
    {
      "start": 12.211443999999998,
      "end": 13.582818999999999,
      "text": "happens fifteen times"
    },
    {
      "start": 13.728443999999998,
      "end": 14.383776999999998,
      "text": "every second."
    },
    {
      "start": 14.643800333333331,
      "end": 15.444758333333331,
      "text": "All that bending"
    },
    {
      "start": 15.456925333333333,
      "end": 16.391383333333334,
      "text": "turns into heat,"
    },
    {
      "start": 16.767592333333333,
      "end": 17.520050333333334,
      "text": "deep inside"
    },
    {
      "start": 17.532133333333334,
      "end": 18.04184233333333,
      "text": "the rubber."
    },
    {
      "start": 18.301865666666664,
      "end": 19.163531666666664,
      "text": "The heat slowly"
    },
    {
      "start": 19.175657666666666,
      "end": 19.952364666666664,
      "text": "cooks the glue"
    },
    {
      "start": 19.964490666666666,
      "end": 20.547031666666665,
      "text": "that holds the"
    },
    {
      "start": 20.559157666666664,
      "end": 21.724198666666666,
      "text": "steel belts together."
    },
    {
      "start": 21.984222000000003,
      "end": 22.651680000000002,
      "text": "Until the tread"
    },
    {
      "start": 22.663847,
      "end": 23.768222,
      "text": "peels away, and"
    },
    {
      "start": 23.780347000000003,
      "end": 24.654139,
      "text": "the tire bursts"
    },
    {
      "start": 24.666264,
      "end": 24.872555000000002,
      "text": "in a"
    },
    {
      "start": 24.884722,
      "end": 25.637139,
      "text": "split second."
    },
    {
      "start": 25.897162333333334,
      "end": 26.904411333333332,
      "text": "And tires quietly"
    },
    {
      "start": 26.91657933333333,
      "end": 27.52337023333333,
      "text": "lose about a"
    },
    {
      "start": 27.535495333333333,
      "end": 28.227245333333332,
      "text": "pound of air"
    },
    {
      "start": 28.397162333333334,
      "end": 29.02820433333333,
      "text": "every month."
    },
    {
      "start": 29.288227666666664,
      "end": 29.810060666666665,
      "text": "That's where those"
    },
    {
      "start": 29.822227666666667,
      "end": 30.659601666666667,
      "text": "shreds of rubber"
    },
    {
      "start": 30.671727666666666,
      "end": 31.217852666666666,
      "text": "on the highway"
    },
    {
      "start": 31.229977666666667,
      "end": 31.763976666666665,
      "text": "come from."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 1.8862313333333331,
      "narration_en": "Why do tires explode on the highway?",
      "source_audio_sha256": "a465fbbf521af2ba9e9b7193517c977452ec3d329324ee1d59c1755769a2dc0c"
    },
    {
      "start": 1.8862313333333331,
      "end": 5.617129666666666,
      "narration_en": "Most blowouts start days earlier, with a tire that's just a little low.",
      "source_audio_sha256": "fdd326f3c6cedfa9e639ae275a80e715bdddff007302f9e732ddc1f9ceb81d82"
    },
    {
      "start": 5.617129666666666,
      "end": 10.525236,
      "narration_en": "Every time it rolls, the soft sidewall bends flat at the bottom, then springs back.",
      "source_audio_sha256": "fab80b07163892e109c8f491651efc11ee733a726402d6f87536bc3099820248"
    },
    {
      "start": 10.525236,
      "end": 14.583800333333333,
      "narration_en": "At sixty miles an hour, that happens fifteen times every second.",
      "source_audio_sha256": "36518d62f30d1f8b13ba05d2d7aa8d33352f78f82410c4d255d8ad3b9a34090b"
    },
    {
      "start": 14.583800333333333,
      "end": 18.241865666666666,
      "narration_en": "All that bending turns into heat, deep inside the rubber.",
      "source_audio_sha256": "a60d67c10b1097452421f90e6ac23b4981c0a30d6d1c449787cb9ecc08c07bc6"
    },
    {
      "start": 18.241865666666666,
      "end": 21.924222,
      "narration_en": "The heat slowly cooks the glue that holds the steel belts together.",
      "source_audio_sha256": "f924b4142ea6aacb38055851b94ef6ab95fea2048bf4a5d881d27be97b242254"
    },
    {
      "start": 21.924222,
      "end": 25.837162333333332,
      "narration_en": "Until the tread peels away, and the tire bursts in a split second.",
      "source_audio_sha256": "a1cce9f059a595b37647e6a11501cae2875cdd66aa231d3d03cdf40bbc5a9245"
    },
    {
      "start": 25.837162333333332,
      "end": 29.228227666666665,
      "narration_en": "And tires quietly lose about a pound of air every month.",
      "source_audio_sha256": "aab83d995dac55dee26a5f410b1839c8cb52a1735886ee144b32673d3bee4444"
    },
    {
      "start": 29.228227666666665,
      "end": 31.964,
      "narration_en": "That's where those shreds of rubber on the highway come from.",
      "source_audio_sha256": "32d03e24602837c1e425363074fef7f7bb21a13aa62113d502da94bb47b87418"
    }
  ],
