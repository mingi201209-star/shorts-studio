{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 34.432,
  "cues": [
    {
      "start": 0.06,
      "end": 0.446583,
      "text": "Why is the"
    },
    {
      "start": 0.459458,
      "end": 0.9749159999999999,
      "text": "end of this"
    },
    {
      "start": 0.987833,
      "end": 1.773916,
      "text": "runway built"
    },
    {
      "start": 1.786791,
      "end": 2.315125,
      "text": "to crumble?"
    },
    {
      "start": 2.5751065454545463,
      "end": 3.322522545454546,
      "text": "Sometimes a jet"
    },
    {
      "start": 3.3353975454545464,
      "end": 4.250356545454546,
      "text": "can't stop and"
    },
    {
      "start": 4.263231545454546,
      "end": 4.7013975454545465,
      "text": "runs off"
    },
    {
      "start": 4.714272545454546,
      "end": 5.191064545454546,
      "text": "the end."
    },
    {
      "start": 5.4510460909090925,
      "end": 6.417545090909093,
      "text": "So many airports"
    },
    {
      "start": 6.469046090909093,
      "end": 6.920087090909093,
      "text": "add a bed"
    },
    {
      "start": 6.933004090909093,
      "end": 7.5515450909090935,
      "text": "of crushable"
    },
    {
      "start": 7.564421090909093,
      "end": 8.595337090909094,
      "text": "concrete blocks."
    },
    {
      "start": 8.85531863636364,
      "end": 9.30635963636364,
      "text": "It looks like"
    },
    {
      "start": 9.31923563636364,
      "end": 10.41461063636364,
      "text": "pavement, but it's"
    },
    {
      "start": 10.42748563636364,
      "end": 11.38110963636364,
      "text": "light and full"
    },
    {
      "start": 11.39398563636364,
      "end": 12.02544363636364,
      "text": "of bubbles."
    },
    {
      "start": 12.285425181818185,
      "end": 12.775091181818185,
      "text": "Under the weight"
    },
    {
      "start": 12.788008181818185,
      "end": 13.432341181818186,
      "text": "of a plane,"
    },
    {
      "start": 13.715842181818186,
      "end": 14.746799181818186,
      "text": "the blocks crush."
    },
    {
      "start": 15.006780727272732,
      "end": 15.72840472727273,
      "text": "The tires sink"
    },
    {
      "start": 15.741321727272732,
      "end": 16.952613727272734,
      "text": "in, like driving"
    },
    {
      "start": 16.965530727272732,
      "end": 17.906279727272732,
      "text": "into deep sand."
    },
    {
      "start": 18.16626127272728,
      "end": 18.900803272727277,
      "text": "Every block they"
    },
    {
      "start": 18.913678272727278,
      "end": 19.880178272727278,
      "text": "crush takes away"
    },
    {
      "start": 19.89309427272728,
      "end": 20.137885272727278,
      "text": "some of"
    },
    {
      "start": 20.150803272727277,
      "end": 20.692052272727278,
      "text": "the speed."
    },
    {
      "start": 20.952033818181825,
      "end": 21.377282818181822,
      "text": "It's built to"
    },
    {
      "start": 21.390200818181825,
      "end": 22.098949818181822,
      "text": "stop a jet"
    },
    {
      "start": 22.111825818181824,
      "end": 23.026783818181823,
      "text": "rolling in at"
    },
    {
      "start": 23.168533818181825,
      "end": 23.761324818181823,
      "text": "eighty miles"
    },
    {
      "start": 23.77420081818182,
      "end": 24.238116818181823,
      "text": "an hour."
    },
    {
      "start": 24.49809836363637,
      "end": 25.090889363636368,
      "text": "It has already"
    },
    {
      "start": 25.103765363636366,
      "end": 26.03163936363637,
      "text": "stopped more than"
    },
    {
      "start": 26.044515363636368,
      "end": 27.255848363636368,
      "text": "two dozen planes,"
    },
    {
      "start": 27.47493136363637,
      "end": 28.44143136363637,
      "text": "with hundreds aboard."
    },
    {
      "start": 28.701412909090916,
      "end": 30.131828909090913,
      "text": "Afterward, crews just"
    },
    {
      "start": 30.144704909090915,
      "end": 30.647287909090913,
      "text": "replace the"
    },
    {
      "start": 30.660204909090915,
      "end": 31.562245909090915,
      "text": "crushed blocks."
    },
    {
      "start": 31.822227454545462,
      "end": 32.440810454545456,
      "text": "That's the gray"
    },
    {
      "start": 32.45368545454546,
      "end": 33.072227454545455,
      "text": "pad at the"
    },
    {
      "start": 33.08514445454546,
      "end": 33.39439345454546,
      "text": "end of"
    },
    {
      "start": 33.40726945454546,
      "end": 34.23201845454546,
      "text": "some runways."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 2.5151065454545463,
      "narration_en": "Why is the end of this runway built to crumble?",
      "source_audio_sha256": "27c862141dd99d57e3f1d9f429d7459062be1649f948f538c1d2ac7f4c573efd"
    },
    {
      "start": 2.5151065454545463,
      "end": 5.391046090909093,
      "narration_en": "Sometimes a jet can't stop and runs off the end.",
      "source_audio_sha256": "202f76b513a8adcf40f45f31db33fff6e397d8140c722537fb10eefd71ad4a75"
    },
    {
      "start": 5.391046090909093,
      "end": 8.795318636363639,
      "narration_en": "So many airports add a bed of crushable concrete blocks.",
      "source_audio_sha256": "54a7bbbecc8e9cd090f04655e2826d5a5f2ca691a2759d991ec84ea017e98d59"
    },
    {
      "start": 8.795318636363639,
      "end": 12.225425181818185,
      "narration_en": "It looks like pavement, but it's light and full of bubbles.",
      "source_audio_sha256": "58ce4325f4aabf92a58ec9223b7a5b7c545fa53fe0775e38f79b5a3e6cc10716"
    },
    {
      "start": 12.225425181818185,
      "end": 14.946780727272731,
      "narration_en": "Under the weight of a plane, the blocks crush.",
      "source_audio_sha256": "066d996107335b8ecbb676d605c57db74d5a5ccdb381d2fdcae64b58b1911f3f"
    },
    {
      "start": 14.946780727272731,
      "end": 18.106261272727277,
      "narration_en": "The tires sink in, like driving into deep sand.",
      "source_audio_sha256": "571e925ac8edc27bb2c852bf4de8b525ed80ed0d11903a4ca5dc463d5345b4d5"
    },
    {
      "start": 18.106261272727277,
      "end": 20.892033818181822,
      "narration_en": "Every block they crush takes away some of the speed.",
      "source_audio_sha256": "b097ba3b4233acf5a3f2778dd5bcc1a268a34194c815b8bc303aee5352699b07"
    },
    {
      "start": 20.892033818181822,
      "end": 24.438098363636367,
      "narration_en": "It's built to stop a jet rolling in at eighty miles an hour.",
      "source_audio_sha256": "2b94baa7a9e20a95e3c090760b8ca733eeb464c708443c359de9470b3fd19969"
    },
    {
      "start": 24.438098363636367,
      "end": 28.641412909090914,
      "narration_en": "It has already stopped more than two dozen planes, with hundreds aboard.",
      "source_audio_sha256": "9fd7a7c819e4972eb03a761cbf2810c116f6d20ec8ab7426359bf7a2b390e896"
    },
    {
      "start": 28.641412909090914,
      "end": 31.76222745454546,
      "narration_en": "Afterward, crews just replace the crushed blocks.",
      "source_audio_sha256": "1d7681cd61bff9a962a748f508e33e78b733ca62ad080f3fa45bd8a0c8752d15"
    },
    {
      "start": 31.76222745454546,
      "end": 34.432,
      "narration_en": "That's the gray pad at the end of some runways.",
      "source_audio_sha256": "31565ecfeaaa615f598cbd55f242c9183af7e840a77c60044f0cd39d973ca6bf"
    }
  ],
