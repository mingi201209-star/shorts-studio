{
  "status": "PASS",
  "voice": "en-US-AndrewNeural",
  "rate": "+5%",
  "seconds": 40.269,
  "cues": [
    {
      "start": 0.06,
      "end": 1.143333,
      "text": "Same emergency stop."
    },
    {
      "start": 1.536166,
      "end": 2.595707,
      "text": "Only one of\\Nthese cars can"
    },
    {
      "start": 2.607625,
      "end": 3.286208,
      "text": "still steer."
    },
    {
      "start": 3.5862055384615386,
      "end": 5.3242885384615395,
      "text": "Slam the\\Nbrakes without ABS"
    },
    {
      "start": 5.443330538461538,
      "end": 6.300454538461539,
      "text": "and the wheels lock."
    },
    {
      "start": 6.6004520769230774,
      "end": 8.159993076923078,
      "text": "A locked\\Ntire stops rolling"
    },
    {
      "start": 8.302827076923078,
      "end": 9.183785076923078,
      "text": "and starts to slide"
    },
    {
      "start": 9.483782615384618,
      "end": 10.817115615384617,
      "text": "and a sliding\\Ntire can't push"
    },
    {
      "start": 10.828990615384617,
      "end": 11.757573615384617,
      "text": "the car sideways."
    },
    {
      "start": 12.057571153846157,
      "end": 13.414737153846156,
      "text": "So turn the\\Nwheel all you want"
    },
    {
      "start": 13.676654153846156,
      "end": 14.533779153846156,
      "text": "and the car still goes"
    },
    {
      "start": 14.545696153846157,
      "end": 14.926654153846156,
      "text": "straight."
    },
    {
      "start": 15.226651692307696,
      "end": 16.786151692307694,
      "text": "ABS stops\\Nthe wheels from"
    },
    {
      "start": 16.798067692307693,
      "end": 17.167108692307693,
      "text": "locking."
    },
    {
      "start": 17.467106230769232,
      "end": 18.80048023076923,
      "text": "Behind each\\Nwheel a sensor"
    },
    {
      "start": 18.812356230769232,
      "end": 20.312397230769232,
      "text": "counts the teeth\\Non a spinning"
    },
    {
      "start": 20.324272230769232,
      "end": 20.55048023076923,
      "text": "ring"
    },
    {
      "start": 20.85047776923077,
      "end": 22.37431076923077,
      "text": "so the computer\\Nknows how fast"
    },
    {
      "start": 22.43381076923077,
      "end": 23.56472676923077,
      "text": "every wheel is turning."
    },
    {
      "start": 23.86472430769231,
      "end": 24.91230730769231,
      "text": "When one\\Nwheel slows down"
    },
    {
      "start": 24.92422430769231,
      "end": 26.23376530769231,
      "text": "faster than the\\Ncar it's about"
    },
    {
      "start": 26.24568230769231,
      "end": 26.73376530769231,
      "text": "to lock"
    },
    {
      "start": 27.03376284615385,
      "end": 28.83138784615385,
      "text": "so ABS eases\\Nthe brake on"
    },
    {
      "start": 28.84326284615385,
      "end": 29.855178846153848,
      "text": "that wheel\\Nfor an instant"
    },
    {
      "start": 30.128970846153848,
      "end": 30.974261846153848,
      "text": "and squeezes again"
    },
    {
      "start": 31.274259384615387,
      "end": 32.17900838461539,
      "text": "many times a second."
    },
    {
      "start": 32.479005923076926,
      "end": 33.75283892307692,
      "text": "The tire keeps\\Nrolling at the"
    },
    {
      "start": 33.764755923076926,
      "end": 34.586171923076925,
      "text": "edge of its grip"
    },
    {
      "start": 34.78854692307692,
      "end": 35.919463923076925,
      "text": "so it can still steer."
    },
    {
      "start": 36.219461461538465,
      "end": 38.06471046153846,
      "text": "That buzz in\\Nthe pedal is ABS"
    },
    {
      "start": 38.076627461538465,
      "end": 38.457585461538464,
      "text": "working."
    },
    {
      "start": 38.86233646153846,
      "end": 40.02900246153846,
      "text": "Keep pressing and steer."
    }
  ],
  "beats": [
    {
      "start": 0,
      "end": 3.5262055384615385,
      "narration_en": "Same emergency stop. Only one of these cars can still steer.",
      "source_audio_sha256": "455ba1d374132b839884aed4f88f0ef66a3d1fe51f8f004bae4d4ad8c1d7fd5c"
    },
    {
      "start": 3.5262055384615385,
      "end": 6.540452076923078,
      "narration_en": "Slam the brakes without ABS and the wheels lock.",
      "source_audio_sha256": "32d0adeb6b62ad3edabc9bc8e685da24d75f48de751ac583769df58d2feb89dd"
    },
    {
      "start": 6.540452076923078,
      "end": 9.423782615384617,
      "narration_en": "A locked tire stops rolling and starts to slide",
      "source_audio_sha256": "8291de2b5ee39b5c0e558a0f0eff956e84dd4059ec39846c7a4fc5cfe8d97bcb"
    },
    {
      "start": 9.423782615384617,
      "end": 11.997571153846156,
      "narration_en": "and a sliding tire can't push the car sideways.",
      "source_audio_sha256": "dad7c083ba79022a0f27f04b5a5b1de89196744abb9ace27e2bb55758c6d6ab9"
    },
    {
      "start": 11.997571153846156,
      "end": 15.166651692307695,
      "narration_en": "So turn the wheel all you want and the car still goes straight.",
      "source_audio_sha256": "f1d82b5e9e1c4a72add3e9966f01383640996348569285e53c43d6f319769cdd"
    },
    {
      "start": 15.166651692307695,
      "end": 17.407106230769234,
      "narration_en": "ABS stops the wheels from locking.",
      "source_audio_sha256": "22228fe7874d1ac82591a3cb4e00601a0c6b8669db9e311183c7733523fba941"
    },
    {
      "start": 17.407106230769234,
      "end": 20.790477769230773,
      "narration_en": "Behind each wheel a sensor counts the teeth on a spinning ring",
      "source_audio_sha256": "9b043bb905d04f4c5e918dbf661b39a99eaaa301e0779dd6aa5eeece60252bda"
    },
    {
      "start": 20.790477769230773,
      "end": 23.80472430769231,
      "narration_en": "so the computer knows how fast every wheel is turning.",
      "source_audio_sha256": "5801e36b731ee88a74e2bd6bbc5961bd255b7df1c30a459bd3db8573f5a8ed6d"
    },
    {
      "start": 23.80472430769231,
      "end": 26.97376284615385,
      "narration_en": "When one wheel slows down faster than the car it's about to lock",
      "source_audio_sha256": "3ba90985ee819d528c548746dcdf4ac8b287398cc8a3113976ceed5531824c13"
    },
    {
      "start": 26.97376284615385,
      "end": 31.21425938461539,
      "narration_en": "so ABS eases the brake on that wheel for an instant and squeezes again",
      "source_audio_sha256": "342ab8f63e6590c2aad9ed1ef262d75538b5d586d6efe309923535b328dca382"
    },
    {
      "start": 31.21425938461539,
      "end": 32.419005923076924,
      "narration_en": "many times a second.",
      "source_audio_sha256": "4d4d4c06af351134e40e874236f8543e72a77046b6e00a489e711c38d8038d50"
    },
    {
      "start": 32.419005923076924,
      "end": 36.15946146153846,
      "narration_en": "The tire keeps rolling at the edge of its grip so it can still steer.",
      "source_audio_sha256": "48ed207530d76072e33d6efd6804af42e60cd4cacd7a35da6f6efad8c10bfd70"
    },
    {
      "start": 36.15946146153846,
      "end": 40.269,
      "narration_en": "That buzz in the pedal is ABS working. Keep pressing and steer.",
      "source_audio_sha256": "a7ba11d813cd6f01b5e6b7f1e926cf9b5dec619762921a6f395ecd28920d6153"
    }
  ],
