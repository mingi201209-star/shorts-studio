    {
      "start": 0.06,
      "end": 1.143333,
      "text": "Same emergency stop."
    },
    {
      "start": 1.536166,
      "end": 2.976625,
      "text": "Only one car\\Ncan still steer."
    },
    {
      "start": 3.376630875,
      "end": 4.317088875,
      "text": "Without ABS,"
    },
    {
