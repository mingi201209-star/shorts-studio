  "cues": [
    {
      "start": 0.06,
      "end": 0.726666,
      "text": "Same crash."
    },
    {
      "start": 1.1195,
      "end": 1.857624,
      "text": "Same seatbelt."
    },
    {
      "start": 2.250458,
      "end": 3.583791,
      "text": "Only one car\\Nhas an airbag."
    },
    {
      "start": 3.8837530769230773,
      "end": 5.086127076923077,
      "text": "The belt\\Nholds your chest"
    },
    {
      "start": 5.205211076923077,
      "end": 6.455211076923077,
      "text": "but your\\Nhead keeps going"
    },
    {
      "start": 6.755173153846155,
      "end": 8.017047153846155,
      "text": "and without an\\Nairbag it hits"
    },
    {
      "start": 8.028964153846154,
      "end": 8.778964153846156,
      "text": "the steering wheel."
    },
    {
      "start": 9.078926230769232,
      "end": 10.567008230769233,
      "text": "A crash sensor\\Nfeels the car"
    },
    {
      "start": 10.578926230769232,
      "end": 12.102759230769232,
      "text": "slow down in\\Nthe first few"
    },
    {
      "start": 12.114634230769232,
      "end": 12.840842230769232,
      "text": "milliseconds"
    },
    {
      "start": 13.140804307692308,
      "end": 14.271762307692308,
      "text": "and decides\\Nin an instant"
    },
    {
      "start": 14.283637307692308,
      "end": 15.724095307692307,
      "text": "that this is\\Na real crash."
    },
    {
      "start": 16.024057384615386,
      "end": 17.940723384615385,
      "text": "It fires a\\Ntiny igniter inside"
    },
    {
      "start": 17.952640384615385,
      "end": 18.726473384615385,
      "text": "the steering wheel"
    },
    {
      "start": 19.026435461538462,
      "end": 20.41930946153846,
      "text": "which sets off\\Na gas generator."
    },
    {
      "start": 20.719271538461538,
      "end": 22.421645538461537,
      "text": "The gas splits\\Nthe cover along"
    },
    {
      "start": 22.433562538461537,
      "end": 23.135896538461537,
      "text": "a hidden seam"
    },
    {
      "start": 23.435858615384614,
      "end": 24.935857615384613,
      "text": "and fills the\\Nfolded bag in"
    },
    {
      "start": 24.947733615384614,
      "end": 26.316816615384614,
      "text": "about\\Nthirty milliseconds."
    },
    {
      "start": 26.61677869230769,
      "end": 27.49773669230769,
      "text": "Here is the clever part."
    },
    {
      "start": 27.90248769230769,
      "end": 28.89061169230769,
      "text": "The bag has holes in it."
    },
    {
      "start": 29.190573769230767,
      "end": 30.535781769230766,
      "text": "As your head\\Nsinks in the gas"
    },
    {
      "start": 30.547698769230767,
      "end": 31.761989769230766,
      "text": "escapes through\\Nthe vents"
    },
    {
      "start": 32.061951846153846,
      "end": 33.24049284615385,
      "text": "so the bag\\Nslows you down"
    },
    {
      "start": 33.252409846153846,
      "end": 34.81195084615385,
      "text": "gently instead\\Nof bouncing you"
    },
    {
      "start": 34.82382684615384,
      "end": 35.216701846153846,
      "text": "back."
    },
    {
      "start": 35.516663923076926,
      "end": 36.63570492307693,
      "text": "That is why\\Nyou should sit back"
    },
    {
      "start": 36.647621923076926,
      "end": 37.242829923076926,
      "text": "from the wheel"
    },
    {
      "start": 37.492829923076926,
      "end": 38.469037923076925,
      "text": "and always\\Nwear your belt."
    }
  ],
  "beats": [
