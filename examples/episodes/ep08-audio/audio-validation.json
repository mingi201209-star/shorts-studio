    },
    {
      "start": 15.964057384615385,
      "end": 18.966435461538463,
      "narration_en": "It fires a tiny igniter inside the steering wheel",
      "source_audio_sha256": "5a049eae2d8b66b4e831f2e251dde443f7a3a475e27fdd2a5fa575b81e291a9a"
