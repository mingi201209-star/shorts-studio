    },
    {
      "start": 10.6661875,
      "end": 13.429916666666667,
      "narration_en": "Even a jet that couldn't stop in time.",
      "source_audio_sha256": "8d222079f76ffcfcf49b1bb18f821b2e112e1d06b7020d8f876942f01ef055e6"
    },
    {
      "start": 13.429916666666667,
      "end": 19.034270833333334,
      "narration_en": "Stopping them is easy. Stopping them without hurting anyone is the hard part.",
      "source_audio_sha256": "118adee4af03ae9bea9dc0ef87ef15ddf398aa2d4abc7af5e538ce5632b5d176"
    },
    {
      "start": 19.034270833333334,
      "end": 24.798,
      "narration_en": "Here are seven clever ways engineers do it, and the one trick almost all of them share.",
      "source_audio_sha256": "8c40b01f09a490bb939434f89b7a4500cdc6b3591a2de0bf0195d9d3685786bf"
